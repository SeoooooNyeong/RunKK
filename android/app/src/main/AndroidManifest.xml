<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".RunkkApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Runkk">
        <!-- singleTask: 외부 앱(카카오톡·브라우저)에서 초대 링크로 열어도 화면 그래프가 하나다(D-272). 새 링크는 onNewIntent로 받는다. -->
        <!-- portrait: 폰·폴드 바깥 화면은 세로 고정. 짧은 변 600dp 이상(폴드 펼침·태블릿)은 Android 16이 무시하므로 화면이 가로에서도 깨지지 않게 그린다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 친구 대결 초대 앱 링크(D-272): https://k15a207.p.ssafy.io/invite/battle/{token}. 검증 파일은 서버 nginx assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="k15a207.p.ssafy.io"
                    android:pathPrefix="/invite/battle/" />
            </intent-filter>
            <!-- 크루 초대 앱 링크([임시:D-성-239]): https://k15a207.p.ssafy.io/invite/crew/{CODE}. 검증 파일은 대결 초대와 같은 assetlinks.json(호스트 단위). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="k15a207.p.ssafy.io"
                    android:pathPrefix="/invite/crew/" />
            </intent-filter>
            <!-- 카카오톡 초대 메시지의 실행 링크(D-270): kakao{앱 키}://kakaolink?invite={token}, 크루 초대는 ?crewInvite={CODE}. 스킴은 빌드 속성 KAKAO_NATIVE_APP_KEY. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="${kakaoScheme}"
                    android:host="kakaolink" />
            </intent-filter>
        </activity>
    </application>

</manifest>
