<?xml version="1.0" encoding="utf-8"?>
<!-- 런처 아이콘: 한글 "런크크" 워드마크(라임 + 보라) adaptive icon, 배경 #09090b.
     전경 PNG(108dp 캔버스)는 워드마크를 가로 58dp로 가운데 두어 원형 마스크 안전 영역(지름 66dp) 안에 든다. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_logo" />
    <monochrome android:drawable="@drawable/ic_launcher_logo" />
</adaptive-icon>
