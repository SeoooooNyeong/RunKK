# HTTP 설정(인증서 발급 전·로컬). nginx 이미지가 시작할 때 ${SERVER_NAME}을 채운다.
# 인증서가 생기면 deploy.sh가 nginx/https를 고른다(NGINX_MODE=https, README 2절).
#   80   prod 환경(api-prod) + ACME 확인 + 모니터링 /grafana/
#   8443 develop 환경(api-develop). 이 모드에서는 평문 HTTP다
# api 컨테이너는 배포 때마다 다시 만들어져 IP가 바뀐다. 시작 때 한 번만 풀면 502가 나므로 Docker 내장 DNS로 주기적으로 다시 푼다.
# 공통 경로는 /etc/nginx/runkk/app-locations.conf(infra/nginx/common)에 있다.
resolver 127.0.0.11 valid=10s ipv6=off;

# Grafana Live(WebSocket)만 Upgrade로 넘기고 나머지 요청은 보통 연결로 둔다
map $http_upgrade $grafana_connection {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    # Let's Encrypt HTTP-01 challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    set $api_upstream api-prod:8080;
    # actuator 관리 포트. 밖에는 /actuator/health 하나만 이 포트로 넘긴다
    set $api_management_upstream api-prod:8081;

    include /etc/nginx/runkk/grafana-locations.conf;
    include /etc/nginx/runkk/app-locations.conf;
}

server {
    listen 8443;
    server_name ${SERVER_NAME};

    set $api_upstream api-develop:8080;
    set $api_management_upstream api-develop:8081;

    include /etc/nginx/runkk/app-locations.conf;
}
