# Rendered by the nginx image at startup (envsubst on ${SERVER_NAME}).
# HTTP only. Once the certificate exists, deploy.sh picks nginx/https instead (NGINX_MODE=https, see README).
# api 컨테이너는 배포 때마다 다시 만들어져 IP가 바뀐다. 시작 때 한 번만 풀면 502가 나므로 Docker 내장 DNS로 주기적으로 다시 푼다.
# 변수로 proxy_pass를 쓰면 nginx가 요청 때 이름을 풀어 resolver를 따른다(URI를 붙이지 않아 원래 경로가 그대로 넘어간다).
resolver 127.0.0.11 valid=10s ipv6=off;

# Grafana Live(WebSocket)만 Upgrade로 넘기고 나머지 요청은 보통 연결로 둔다
map $http_upgrade $grafana_connection {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    set $api_upstream api:8080;
    # actuator 관리 포트(develop·prod). 밖에는 /actuator/health 하나만 이 포트로 넘긴다
    set $api_management_upstream api:8081;
    # 모니터링 Grafana. 변수로 두어 grafana 컨테이너가 없어도 nginx는 뜨고 /grafana/만 502가 난다
    set $grafana_upstream grafana:3000;

    client_max_body_size 10m;

    # Let's Encrypt HTTP-01 challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 실시간 대결·크루런 WebSocket(설계 5.7.2, D-06). Upgrade 헤더를 넘기고, 러닝 한 회 동안 연결이 끊기지 않게 읽기 제한을 길게 둔다
    location /ws {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 2h;
        proxy_send_timeout 2h;
    }

    # 외부에는 /actuator/health만 연다(배포 스모크용). info·prometheus 등 나머지 actuator 경로는 숨긴다
    location = /actuator/health {
        proxy_pass http://$api_management_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }

    location ^~ /actuator/ {
        return 404;
    }

    # 공개 홈과 법정 고지 문서(개인정보 처리방침·이용약관·위치정보 이용약관·도움말). Google OAuth 동의 화면과 앱 설정 링크
    # (application.yml runkk.legal.*-url)가 연다. 파일은 infra/nginx/static을 읽기 전용으로 연결한다. /legal/privacy → privacy.html
    location = / {
        root /usr/share/nginx/runkk;
        charset utf-8;
        try_files /index.html =404;
    }

    location ^~ /legal/ {
        root /usr/share/nginx/runkk;
        charset utf-8;
        try_files $uri $uri.html =404;
    }

    # 모니터링 대시보드(S15P31A207-78). Grafana 로그인(관리자 계정)으로만 들어간다. Grafana가 serve_from_sub_path로
    # /grafana/ 경로를 직접 받으므로 경로를 그대로 넘긴다(proxy_pass에 URI를 붙이지 않는다)
    location = /grafana {
        # 상대 주소로 돌려보내 로컬처럼 80이 아닌 포트로 열어도 같은 포트에 머문다
        absolute_redirect off;
        return 301 /grafana/;
    }

    location ^~ /grafana/ {
        proxy_pass http://$grafana_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $grafana_connection;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
