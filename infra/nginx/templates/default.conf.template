# Rendered by the nginx image at startup (envsubst on ${SERVER_NAME}).
# HTTP only. After the certificate exists, replace this file with https.conf.template (see README).
upstream api {
    server api:8080;
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    client_max_body_size 10m;

    # Let's Encrypt HTTP-01 challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 실시간 대결·크루런 WebSocket(설계 5.7.2, D-06). Upgrade 헤더를 넘기고, 러닝 한 회 동안 연결이 끊기지 않게 읽기 제한을 길게 둔다
    location /ws {
        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 2h;
        proxy_send_timeout 2h;
    }

    location / {
        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
