# HTTPS version. Copy over templates/default.conf.template once /etc/letsencrypt/live/${SERVER_NAME}/ exists:
# HTTPS version. deploy.sh mounts this folder (NGINX_MODE=https) when /etc/letsencrypt/live/${SERVER_NAME}/ exists;
#   init-letsencrypt.sh switches to it right after the first certificate is issued.
# 변수로 proxy_pass를 쓰면 nginx가 요청 때 이름을 풀어 resolver를 따른다(URI를 붙이지 않아 원래 경로가 그대로 넘어간다).
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name ${SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    set $api_upstream api:8080;

    client_max_body_size 10m;

    # 실시간 대결·크루런 WebSocket(설계 5.7.2, D-06). Upgrade 헤더를 넘기고, 러닝 한 회 동안 연결이 끊기지 않게 읽기 제한을 길게 둔다
    location /ws {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 2h;
        proxy_send_timeout 2h;
    }

    # 외부에는 /actuator/health만 연다(배포 스모크용). info·metrics 등 나머지 actuator 경로는 숨긴다
    location = /actuator/health {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }

    location ^~ /actuator/ {
        return 404;
    }

    # 공개 홈과 법정 고지 문서(개인정보 처리방침·이용약관·위치정보 이용약관·도움말). Google OAuth 동의 화면과 앱 설정 링크
    # (application.yml runkk.legal.*-url)가 연다. 파일은 infra/nginx/static을 읽기 전용으로 연결한다. /legal/privacy → privacy.html
    location = / {
        root /usr/share/nginx/runkk;
        charset utf-8;
        try_files /index.html =404;
    }

    location ^~ /legal/ {
        root /usr/share/nginx/runkk;
        charset utf-8;
        try_files $uri $uri.html =404;
    }

    location / {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
