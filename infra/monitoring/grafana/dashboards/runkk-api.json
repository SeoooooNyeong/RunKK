     "expr": "(sum(rate(http_server_requests_seconds_count{job=\"api\",env=\"$env\",uri!~\"/actuator.*\",status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{job=\"api\",env=\"$env\",uri!~\"/actuator.*\"}[5m]))",
     "instant": true
    }
   ]
  },
  {
