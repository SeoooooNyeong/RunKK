# 환경 스택(docker-compose.yml) 값. 서버에서 .env로 복사한다. .env는 커밋하지 않는다.
# 환경마다 한 벌: develop은 CI 변수 INFRA_ENV, prod는 INFRA_ENV_PROD(File 타입)에 이 내용을 채운다.
# nginx·모니터링 값(SERVER_NAME, 포트, Grafana)은 여기가 아니라 edge.env(edge.env.example, CI INFRA_ENV_EDGE)에 둔다.
# 값 옆에 주석을 달지 않는다. 빈 값 뒤 주석은 compose가 값으로 읽으므로 설명은 항상 윗줄에 쓴다.

# 환경 이름(필수): develop | prod. compose 프로젝트 이름(runkk-develop|runkk-prod), 이미지 태그, nginx·Prometheus 별칭(api-<환경>)이 된다
RUNKK_ENV=develop
# DB·Redis 볼륨 이름(필수). develop은 분리 전 볼륨을 그대로 이어 쓴다(runkk_postgres-data, runkk_redis-data).
# prod는 runkk-prod_postgres-data, runkk-prod_redis-data. 다른 환경 볼륨 이름을 넣지 않는다(deploy.sh가 쓰는 중인 볼륨이면 멈춘다)
POSTGRES_VOLUME=runkk_postgres-data
REDIS_VOLUME=runkk_redis-data

# prod 환경은 prod(필수, deploy.sh가 확인), develop 환경은 develop
SPRING_PROFILES_ACTIVE=develop
# prod 프로필에서만 쓴다. prod 환경에서는 넣지 않는다(deploy.sh가 true면 멈춘다). develop 프로필은 늘 /docs를 연다
SWAGGER_ENABLED=false
# 셀카 변환 서버 스위치. 비우면 꺼짐. prod(베타)는 false(2026-10-23 결정), 셀카를 시험하는 develop만 true
SELFIE_ENABLED=true

DB_NAME=runkk
DB_USER=runkk
# 필수(DB_NAME·DB_USER도). 비면 compose가 바로 멈춘다
DB_PASSWORD=change-me
# 필수. ai 전용 DB 계정 runkk_ai 비밀번호(Flyway V29가 계정을 만든다). 영숫자만(예: openssl rand -hex 24).
# 아래 RUNKK_DB_URL의 비밀번호와 같은 값이다. 계정이 생긴 뒤 바꾸려면 DB에서 ALTER ROLE도 해야 한다
RUNKK_AI_DB_PASSWORD=change-me
# api Hikari 최대 풀(PostgreSQL max_connections 100 안)
DB_POOL_SIZE=50
# postgres(5432)·redis(6379)는 내부 망에서 기본 포트로 고정한다(밖으로 열지 않는다). 포트 변수는 없다.
# 필수. redis --requirepass와 api가 같은 값을 쓴다(예: openssl rand -hex 24)
REDIS_PASSWORD=change-me

# api 컨테이너 메모리 제한과 JVM 옵션. 비우면 1536m, 힙은 제한의 60%(-XX:MaxRAMPercentage=60)
API_MEM_LIMIT=
API_JAVA_OPTS=

# 매일 백업(README "백업"). 비우면 04:30에 /var/backups/runkk/<RUNKK_ENV>로 뜨고 7일 보존, 덤프 소유자는 1000:1000(ubuntu)
BACKUP_TIME=
BACKUP_KEEP_DAYS=
BACKUP_DIR=
BACKUP_OWNER=

# api 인증·외부 연동(backend/.env.example에 설명). JWT_SECRET은 필수(32바이트 이상, 예: openssl rand -base64 48)
JWT_SECRET=
# 관리툴 토큰 키. 필수, JWT_SECRET과 다른 값(32바이트 이상)
ADMIN_JWT_SECRET=
# 첫 운영자, 예: KAKAO:1234567890 (화이트리스트가 비었을 때만 적용)
RUNKK_BOOTSTRAP_OPERATORS=
# 운영 기준값 처음 값, 예: CREW_RELEASED=true,AVATAR_RELEASED=true,RUNBODY_ENABLED=true (그 키의 행이 없을 때만 적용, 이후는 관리툴)
RUNKK_BOOTSTRAP_SETTINGS=
SCHEDULER_POOL_SIZE=27
# 랜드마크 배경 알림 없이 채우기 기준 시각(D-176). 첫 배포 때 V25 적용 시각(서버 시간, 예 2026-11-02T03:00:00)으로 바꾼다
AVATAR_BACKFILL_CUTOFF=2026-10-22T00:00:00
# 로그인 계열 요청의 클라이언트별 분당 상한
AUTH_CLIENT_REQUESTS_PER_MINUTE=30
# 법정 고지 문서 주소. 비우면 서버 기본값(ssafy 도메인 443)이 쓰인다
LEGAL_TERMS_URL=
LEGAL_PRIVACY_POLICY_URL=
LEGAL_LOCATION_TERMS_URL=
LEGAL_HELP_URL=
# 친구 대결 초대 링크 앞부분. 필수, 환경마다 다르다. develop(8443): https://k15a207.p.ssafy.io:8443/invite/battle, prod(443): https://k15a207.p.ssafy.io/invite/battle
FRIEND_INVITE_LINK_BASE=
KAKAO_APP_ID=
GOOGLE_CLIENT_IDS=
FCM_PROJECT_ID=
# 예: /run/secrets/fcm-service-account.json (파일은 infra/secrets/에 둔다, 커밋 금지)
FCM_CREDENTIALS_FILE=
KMA_SERVICE_KEY=
# redis | jdbc (Redis 장기 장애 때 PostgreSQL 대안)
RUNKK_QUEUE=redis
# websocket | polling (WebSocket이 불안정할 때)
RUNKK_LIVE=websocket

# 컨테이너마다 필요한 값만 받는다(docker-compose.yml environment). api: SPRING_*·SWAGGER_*·DB_*·REDIS_*·JWT_SECRET·외부 연동 키 + RUNKK_INTERNAL_TOKEN,
# ai: RUNKK_* 만. LLM·얼굴 API 키는 api 컨테이너로 가지 않고 DB 비밀번호는 ai 컨테이너로 가지 않는다.

# ai 서버(ai/.env.example에 설명). RUNKK_INTERNAL_TOKEN은 api와 ai가 같은 값을 쓴다(16자 이상).
# 자리표시 값("change-me" 포함)이면 ai가 기동을 거부한다. 예: openssl rand -hex 32
RUNKK_INTERNAL_TOKEN=change-me-to-a-long-random-string
RUNKK_LLM_PROVIDER=claude
RUNKK_LLM_MODEL=claude-haiku-5-5
RUNKK_ANTHROPIC_API_KEY=
# 비우면 공식 주소. SSAFY GMS면 https://gms.ssafy.io/gmsapi/api.anthropic.com
RUNKK_ANTHROPIC_BASE_URL=
RUNKK_OPENAI_API_KEY=
# 아바타(Node) 서버 기준 경로. avatar 프로필을 켠 환경에서 http://avatar:3000/api/v1. 비우면 /faces가 503(앱은 기본 캐릭터)
RUNKK_FACE_API_URL=
RUNKK_EXPOSE_DOCS=false
# AI 코치(F5). 비우면 기본값(claude-haiku-5-5, 하루 전체 300회·사용자별 30회). 키는 RUNKK_ANTHROPIC_API_KEY
RUNKK_COACH_MODEL=
RUNKK_COACH_DAILY_HARD_CAP=
RUNKK_COACH_USER_DAILY_CAP=
# 분석 결과 저장소. analytics 스키마와 runkk_ai 계정(백엔드 Flyway)이 생긴 뒤 채운다. 비우면 메모리(재시작하면 사라짐)
# 예: postgresql://runkk_ai:<비밀번호>@postgres:5432/runkk (환경마다 자기 postgres 서비스 이름은 postgres로 같다)
RUNKK_DB_URL=
# writer(자체 소형 모델, ai/README "writer"). 켜려면 모델 파일을 WRITER_MODEL_DIR에 올리고 아래 두 줄을 채운다.
# RUNKK_WRITER_URL이 writer 전체 스위치다. 비우면 writer 컨테이너가 뜨지 않고 분석 피드백은 템플릿 문장 그대로다.
# 모델 교체·롤백은 재배포 없이 POST /models API로 한다(ai/README "writer 모델 관리")
# 켤 선택 서비스를 쉼표로 적는다. 예: writer,avatar
COMPOSE_PROFILES=
RUNKK_WRITER_URL=
# 관리 API에서 등록 가능한 writer 주소. 여러 주소는 쉼표로 구분한다.
RUNKK_WRITER_MODEL_URLS=http://writer:8080
# 모델 파일 폴더·파일 이름·CPU 스레드. 비우면 /srv/runkk/models, runkk-writer-v1-qwen3-4b-q4_k_m.gguf, 4
WRITER_MODEL_DIR=
WRITER_MODEL_FILE=
WRITER_THREADS=
# 아바타 서버(Node, 안선영 님). COMPOSE_PROFILES에 avatar를 넣고 ../avatar-ai에 Dockerfile이 있어야 deploy.sh가 빌드한다.
# AVATAR_GMS_KEY는 OpenAI 호환 GMS 키(이미지 생성 과금). 비우면 avatar가 떠도 생성이 실패한다
AVATAR_GMS_KEY=
AVATAR_GMS_BASE_URL=
