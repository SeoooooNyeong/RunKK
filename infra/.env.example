# Copy to .env on the server. Never commit .env.
SERVER_NAME=localhost            # EC2 domain, e.g. k15a207.p.ssafy.io
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

SPRING_PROFILES_ACTIVE=prod      # prod on main, develop on the develop server
SWAGGER_ENABLED=false            # prod only; develop always serves /docs

DB_NAME=runkk
DB_USER=runkk
DB_PASSWORD=change-me            # 필수(DB_NAME·DB_USER도). 비면 compose가 바로 멈춘다
DB_POOL_SIZE=50                  # api Hikari 최대 풀(PostgreSQL max_connections 100 안)
# 배포 전 DB 덤프 폴더(deploy.sh만 읽고 컨테이너로는 가지 않는다). CI 작업 폴더 밖 절대 경로여야 한다(작업 폴더는 다음 잡이 지운다).
# 비우면 배포 사용자의 $HOME/runkk-backups. 환경 변수(CI 변수) RUNKK_BACKUP_DIR가 있으면 그 값이 먼저다. 예: /var/backups/runkk
RUNKK_BACKUP_DIR=
# postgres(5432)·redis(6379)는 내부 망에서 기본 포트로 고정한다(밖으로 열지 않는다). 포트 변수는 없다.
REDIS_PASSWORD=change-me         # 필수. redis --requirepass와 api가 같은 값을 쓴다(예: openssl rand -hex 24)

# api 인증·외부 연동(backend/.env.example에 설명). JWT_SECRET은 필수(32바이트 이상, 예: openssl rand -base64 48)
JWT_SECRET=
ADMIN_JWT_SECRET=                # 관리툴 토큰 키. 필수, JWT_SECRET과 다른 값(32바이트 이상)
RUNKK_BOOTSTRAP_OPERATORS=       # 첫 운영자, 예: KAKAO:1234567890 (화이트리스트가 비었을 때만 적용)
SCHEDULER_POOL_SIZE=20
# 랜드마크 배경 알림 없이 채우기 기준 시각(D-176). 첫 배포 때 V25 적용 시각(서버 시간, 예 2026-11-02T03:00:00)으로 바꾼다
AVATAR_BACKFILL_CUTOFF=2026-10-22T00:00:00
AUTH_CLIENT_REQUESTS_PER_MINUTE=30   # 로그인 계열 요청의 클라이언트별 분당 상한
# 법정 고지 문서 주소. 비우면 서버 기본값(ssafy 도메인)이 쓰인다
LEGAL_TERMS_URL=
LEGAL_PRIVACY_POLICY_URL=
LEGAL_LOCATION_TERMS_URL=
LEGAL_HELP_URL=
KAKAO_APP_ID=
GOOGLE_CLIENT_IDS=
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=            # 예: /run/secrets/fcm-service-account.json (파일은 infra/secrets/에, 커밋 금지)
KMA_SERVICE_KEY=
RUNKK_QUEUE=redis                # redis | jdbc (Redis 장기 장애 때 PostgreSQL 대안)
RUNKK_LIVE=websocket             # websocket | polling (WebSocket이 불안정할 때)

# 컨테이너마다 필요한 값만 받는다(docker-compose.yml environment). api: SPRING_*·SWAGGER_*·DB_*·REDIS_*·JWT_SECRET·외부 연동 키 + RUNKK_INTERNAL_TOKEN,
# ai: RUNKK_* 만. LLM·얼굴 API 키는 api 컨테이너로 가지 않고 DB 비밀번호는 ai 컨테이너로 가지 않는다.

# ai 서버(ai/.env.example에 설명). RUNKK_INTERNAL_TOKEN은 api와 ai가 같은 값을 쓴다(16자 이상).
# 자리표시 값("change-me" 포함)이면 ai가 기동을 거부한다. 예: openssl rand -hex 32
RUNKK_INTERNAL_TOKEN=change-me-to-a-long-random-string
RUNKK_LLM_PROVIDER=claude
RUNKK_LLM_MODEL=claude-haiku-5-5
RUNKK_ANTHROPIC_API_KEY=
RUNKK_ANTHROPIC_BASE_URL=           # 비우면 공식 주소. SSAFY GMS면 https://gms.ssafy.io/gmsapi/api.anthropic.com
RUNKK_OPENAI_API_KEY=
RUNKK_FACE_IMPL=external
RUNKK_FACE_API_URL=
RUNKK_FACE_API_KEY=
RUNKK_EXPOSE_DOCS=false
# AI 코치(F5). 비우면 기본값(claude-haiku-5-5, 하루 전체 300회·사용자별 30회). 키는 RUNKK_ANTHROPIC_API_KEY
RUNKK_COACH_MODEL=
RUNKK_COACH_DAILY_HARD_CAP=
RUNKK_COACH_USER_DAILY_CAP=
# 분석 결과 저장소. analytics 스키마와 runkk_ai 계정(백엔드 Flyway)이 생긴 뒤 채운다. 비우면 메모리(재시작하면 사라짐)
RUNKK_DB_URL=                      # 예: postgresql://runkk_ai:<비밀번호>@postgres:5432/runkk
