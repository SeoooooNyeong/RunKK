# 에지 스택(docker-compose.edge.yml: nginx·Prometheus·Grafana) 값. 서버에서 edge.env로 복사한다. edge.env는 커밋하지 않는다.
# 서버에 한 벌만 있다. CI는 develop·main 배포 모두 File 변수 INFRA_ENV_EDGE를 edge.env로 복사한다(두 배포가 같은 값으로 에지를 맞춘다).
# 값 옆에 주석을 달지 않는다. 빈 값 뒤 주석은 compose가 값으로 읽으므로 설명은 항상 윗줄에 쓴다.

# 서버 도메인. 예: k15a207.p.ssafy.io (인증서 이름, prod 443·develop 8443이 같은 이름을 쓴다)
SERVER_NAME=localhost
# 80: ACME + https 리다이렉트(HTTP 모드에서는 prod), 443: prod, 8443: develop. 로컬에서 포트가 겹치면 바꾼다
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_DEVELOP_PORT=8443

# 모니터링(README "모니터링"). Grafana는 https://<SERVER_NAME>/grafana/ 에서 이 계정으로 로그인한다. 익명 접근·회원가입은 꺼져 있다.
# GRAFANA_ADMIN_PASSWORD는 필수(비면 compose가 멈춘다). CI는 따로 둔 masked 변수 GRAFANA_ADMIN_PASSWORD를 이 파일 끝에 붙이므로 INFRA_ENV_EDGE에는 넣지 않는다. grafana-data 볼륨을 처음 만들 때만 쓰이므로 나중에 바꾸려면 README 명령으로 바꾼다.
# 예: openssl rand -base64 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# 장애 알림 Mattermost Incoming Webhook 주소(runkk-alerts 채널, README "장애 알림"). CI는 따로 둔 masked 변수 GRAFANA_ALERT_WEBHOOK_URL을
# 이 파일 끝에 붙이므로 INFRA_ENV_EDGE에는 넣지 않아도 된다. 서버에서 손으로 배포할 때만 여기에 쓴다. 비우면 알림 없이 뜬다
GRAFANA_ALERT_WEBHOOK_URL=

# 로컬 Docker Desktop에서만 /tmp, rprivate로 둔다(VM 루트를 연결할 수 없음). 서버는 비워 둔다(기본 /, rslave)
NODE_EXPORTER_HOST_ROOT=
NODE_EXPORTER_ROOT_PROPAGATION=
