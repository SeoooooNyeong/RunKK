{
  "enabledPlugins": {
    "ecc@ecc": true
  },
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/ECC.git"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(cd backend && ./gradlew *)",
      "Bash(cd android && ./gradlew *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./infra/.env)",
      "Read(./android/local.properties)",
      "Read(./**/*.jks)"
    ]
  }
}
