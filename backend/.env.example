# Copy to .env (never commit .env). Read by docker compose on the server and by the develop/prod profiles.
# local profile needs no .env at all.
SPRING_PROFILES_ACTIVE=develop   # develop | prod
SERVER_PORT=8080
DB_HOST=postgres
DB_PORT=5432
DB_NAME=runkk
DB_USER=runkk
DB_PASSWORD=change-me
REDIS_HOST=redis
REDIS_PORT=6379
SWAGGER_ENABLED=false            # prod only; develop always exposes /docs

# --- B2: 인증·외부 연동 (비우면 그 연동은 꺼진 채로 안전하게 동작한다) ---
# 회원 JWT 서명 키(HS256, 32바이트 이상). 비우면 기동마다 임의 키(재시작 때 토큰 무효). prod는 필수(비면 기동 실패)
JWT_SECRET=
# 카카오 로그인: 토큰을 발급한 앱 ID(access_token_info의 app_id). 비우면 카카오 로그인 거부
KAKAO_APP_ID=
# 구글 로그인: ID 토큰 aud로 받을 OAuth 클라이언트 ID(쉼표 구분). 비우면 구글 로그인 거부
GOOGLE_CLIENT_IDS=
# FCM HTTP v1: 프로젝트 ID와 서비스 계정 JSON 파일 경로. 비우면 푸시를 보내지 않고 로그만
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
# 공공데이터포털 기상청 초단기예보 서비스 키. 비우면 날씨 없이 저장
KMA_SERVICE_KEY=
# api → ai 서버(compose가 넘김). RUNKK_INTERNAL_TOKEN은 prod 필수(비면 기동 실패)
AI_SERVER_URL=http://ai:8000
RUNKK_INTERNAL_TOKEN=change-me
# 법정 고지 문서 공개 주소(선택, 기본값 있음)
# LEGAL_TERMS_URL= LEGAL_PRIVACY_POLICY_URL= LEGAL_LOCATION_TERMS_URL= LEGAL_HELP_URL=

# --- B3: 대결 (비우면 기본값) ---
# 매칭 대기열·진행 중 대결 세션 저장소: redis(기본) | jdbc(Redis 장기 장애 때 PostgreSQL 대안, 설계 D-07)
# 갱신 토큰 폐기 목록은 이 값과 무관하게 PostgreSQL에 둔다(Redis 장애에도 로그인 유지, 확인 불가면 갱신 거부)
RUNKK_QUEUE=redis
# 실시간 방식: websocket(기본, /ws) | polling(/api/v1/live/poll, WebSocket이 불안정할 때, 설계 C-004·D-57)
RUNKK_LIVE=websocket

# --- B4: 크루·아바타·리워드 (비우면 기본값) ---
# DB 연결 풀 크기. 기록 저장 커밋 뒤 동기 수신자가 연결을 하나 더 쓰므로 동시 사용자 규모(50명)에 맞춘다(PostgreSQL max_connections 안)
DB_POOL_SIZE=50

# --- B5: 기록 분석·관리툴 (비우면 기본값) ---
# 관리툴 토큰 서명 키(HS256, 32바이트 이상, JWT_SECRET과 달라야 함). 비우면 기동마다 임의 키(관리툴 재로그인 필요). prod는 필수(비면 기동 실패)
ADMIN_JWT_SECRET=
# 첫 운영자 시드: 화이트리스트가 비었을 때만 시작 때 한 번 넣고 감사 기록을 남긴다. 형식 "KAKAO:계정ID,GOOGLE:계정ID"
RUNKK_BOOTSTRAP_OPERATORS=
# 스케줄러 스레드 수(batch.* 시각 작업 20개: 1초 2개, 1분 2개, 0시 3개, 0시 10분 4개, 0시 30분 1개, 3시 6개, 3시 30분 1개, 20시 1개). 작업이 늘면 함께 늘린다
SCHEDULER_POOL_SIZE=20
