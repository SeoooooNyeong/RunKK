# Copy to .env (never commit .env). Read by docker compose on the server and by the develop/prod profiles.
# local profile needs no .env at all.
SPRING_PROFILES_ACTIVE=develop   # develop | prod
SERVER_PORT=8080
DB_HOST=postgres
DB_PORT=5432
DB_NAME=runkk
DB_USER=runkk
DB_PASSWORD=change-me
REDIS_HOST=redis
REDIS_PORT=6379
SWAGGER_ENABLED=false            # prod only; develop always exposes /docs
