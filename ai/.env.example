# 런크크 ai 서버 환경 변수 예시. 실제 값은 infra/.env에 넣고 커밋하지 않는다.
# ai 서버는 .env 파일을 읽지 않는다. compose가 이 RUNKK_* 변수만 골라 ai 컨테이너에 넘긴다(infra/docker-compose.yml).
# 빈 값은 기본값으로 본다.

# api ↔ ai 내부 토큰(16자 이상). api 컨테이너와 같은 값을 쓴다(5.4, H-23).
# 아래 자리표시 값("change-me" 포함)은 기동을 거부한다. 예: openssl rand -hex 32
RUNKK_INTERNAL_TOKEN=change-me-to-a-long-random-string

# LLM 코멘트(D-58). 제공자는 C-006 선정 결과로 고른다: claude | openai
# 제공자를 바꾸면 모델도 그 제공자 것으로 바꾼다(claude는 claude-*, openai는 claude-* 아닌 모델). 어긋나면 기동을 거부한다
RUNKK_LLM_PROVIDER=claude
RUNKK_LLM_MODEL=claude-haiku-5-5
RUNKK_ANTHROPIC_API_KEY=
RUNKK_OPENAI_API_KEY=
# 기본값: 시간 제한 2.5초(라우터 전체 제한 2.7초보다 짧아야 기동), 출력 상한 200토큰, 프로세스 하루 상한 240회(D-62, 운영 한도와 무관한 고정 값)
# RUNKK_LLM_TIMEOUT_S=2.5
# RUNKK_LLM_MAX_TOKENS=200
# RUNKK_LLM_DAILY_HARD_CAP=240

# 얼굴 변환(D-59). C-011 선정 전에는 external만 쓴다. 주소가 없으면 /faces는 503 UPSTREAM_FAILED
RUNKK_FACE_IMPL=external
RUNKK_FACE_API_URL=
RUNKK_FACE_API_KEY=
# RUNKK_FACE_TIMEOUT_S=12
# RUNKK_MAX_IMAGE_BYTES=1048576
# 셀카 가로 × 세로 상한(머리 정보로 확인, 기본 4096 × 4096)
# RUNKK_MAX_IMAGE_PIXELS=16777216

# AI 코치(F5, POST /coach/chat). 키는 RUNKK_ANTHROPIC_API_KEY, GMS 주소는 ANTHROPIC_BASE_URL을 같이 쓴다.
# 모델은 Claude여야 한다(도구 사용). 하루 상한은 프로세스 전체·사용자별(한국 날짜 기준)
# RUNKK_COACH_MODEL=claude-haiku-5-5
# RUNKK_COACH_MAX_TOKENS=700
# RUNKK_COACH_TIMEOUT_S=45
# RUNKK_COACH_DAILY_HARD_CAP=300
# RUNKK_COACH_USER_DAILY_CAP=30

# 분석 결과 저장소(analytics 스키마). runkk_ai 계정 주소. 비우면 메모리 저장소(재시작하면 사라짐)
# 로컬: postgresql://runkk_ai:runkk_ai@localhost:5432/runkk (ai/README.md "PostgreSQL 저장소")
RUNKK_DB_URL=

# 로컬 개발에서만 /docs·/openapi.json 열기
RUNKK_EXPOSE_DOCS=false
